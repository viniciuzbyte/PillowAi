<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:id="@+id/logoRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_asterisk" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="serif"
                android:text="@string/app_short"
                android:textColor="@color/ink"
                android:textSize="40sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/ivHero"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_hero" />

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="@string/tagline"
            android:textColor="@color/ink"
            android:textSize="32sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/formBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp">

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_input"
                android:hint="@string/email_hint"
                android:imeOptions="actionGo"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingStart="24dp"
                android:paddingEnd="72dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_soft"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/btnGo"
                android:layout_width="64dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_login_go"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_arrow_right" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/accent_dark"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/terms"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
